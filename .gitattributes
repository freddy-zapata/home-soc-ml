# Normaliza fines de linea. Clave para Docker: un .sh con CRLF falla dentro del contenedor.
* text=auto
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.xml       text eol=lf
*.rules     text eol=lf
Dockerfile  text eol=lf
.env.example text eol=lf
# PowerShell se queda en CRLF (se ejecuta en Windows)
*.ps1       text eol=crlf
# Binarios
*.png binary
*.jpg binary
*.pdf binary
*.pcap binary
*.parquet binary
